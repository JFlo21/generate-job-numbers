modules = ["python-3.12"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Run Optimized Job Generator"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Migrate Job Numbers to State Sheet"

[[workflows.workflow]]
name = "Run Optimized Job Generator"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python generate_job_numbers_optimized.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Migrate Job Numbers to State Sheet"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python migrate_existing_job_numbers.py"

[workflows.workflow.metadata]
outputType = "console"
